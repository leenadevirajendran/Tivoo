# ==============================================================================
# Tivoo Backend Configuration Template
# Copy this file to .env and fill in your environment-specific values.
# ==============================================================================

APP_NAME=Tivoo API
APP_ENV=production
APP_DEBUG=false
API_HOST=0.0.0.0
API_PORT=8080
PUBLIC_BASE_URL=http://localhost:8080
ALLOWED_ORIGINS=*

# ------------------------------------------------------------------------------
# MySQL Database (phpMyAdmin / XAMPP / MariaDB)
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=tivoo
DB_USER=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ------------------------------------------------------------------------------
# JWT Authentication & Security
# Generate JWT_SECRET_KEY with: python -c "import secrets; print(secrets.token_hex(32))"
# ------------------------------------------------------------------------------
JWT_SECRET_KEY=CHANGE_THIS_TO_A_SECURE_64_CHAR_RANDOM_HEX_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
OTP_EXPIRE_MINUTES=10
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=45

# ------------------------------------------------------------------------------
# Email OTP & Transactional Mail (Gmail SMTP)
# Generate a 16-character App Password at:
# Google Account -> Security -> 2-Step Verification -> App passwords
# ------------------------------------------------------------------------------
MAIL_SENDER=tivoo5477@gmail.com
MAIL_SENDER_NAME=Tivoo
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_USE_TLS=true
MAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# Phone SMS OTP Provider (none | twilio | webhook)
# ------------------------------------------------------------------------------
SMS_PROVIDER=none
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_WEBHOOK_URL=
SMS_WEBHOOK_API_KEY=

# ------------------------------------------------------------------------------
# Media Storage Driver (local | s3 | r2)
# - local: Saves uploaded & transcoded HLS media under LOCAL_STORAGE_DIR
# - s3:    Amazon S3 bucket
# - r2:    Cloudflare R2 S3-compatible bucket (set S3_ENDPOINT_URL)
# ------------------------------------------------------------------------------
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=storage
MAX_VIDEO_UPLOAD_MB=500
MAX_IMAGE_UPLOAD_MB=15

# AWS S3 / Cloudflare R2 Settings (used when STORAGE_BACKEND is s3 or r2)
S3_BUCKET_NAME=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
CDN_PUBLIC_BASE_URL=

# ------------------------------------------------------------------------------
# FFmpeg Transcoding (H.264 MP4 + Adaptive HLS Streaming)
# ------------------------------------------------------------------------------
FFMPEG_BIN=ffmpeg
FFPROBE_BIN=ffprobe
TRANSCODE_MAX_WORKERS=2
HLS_SEGMENT_SECONDS=4
ENABLE_AUTO_TRANSCODE=true

# ------------------------------------------------------------------------------
# Admin Access & Roles (comma-separated admin emails)
# ------------------------------------------------------------------------------
ADMIN_EMAILS=tivoo5477@gmail.com

# ------------------------------------------------------------------------------
# Live Streaming Gateway (livekit | agora | rtmp)
# ------------------------------------------------------------------------------
LIVE_MEDIA_PROVIDER=livekit
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=
RTMP_INGEST_BASE_URL=rtmp://localhost/live
HLS_LIVE_BASE_URL=
RTMP_WEBHOOK_SECRET=
RTC_TOKEN_EXPIRE_SECONDS=3600

# ------------------------------------------------------------------------------
# Real-Time PK Battle Engine
# ------------------------------------------------------------------------------
PK_DEFAULT_ROUND_SECONDS=300
PK_MIN_ROUND_SECONDS=30
PK_MAX_ROUND_SECONDS=3600

# ------------------------------------------------------------------------------
# Virtual Gift Ledger, Payouts & In-App Purchases (Stripe / Google Play / Apple)
# ------------------------------------------------------------------------------
GIFT_COIN_TO_DIAMOND_RATE=0.70
DIAMOND_TO_CURRENCY_RATE=0.50
PAYOUT_CURRENCY=INR
MIN_WITHDRAWAL_DIAMONDS=100
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SUCCESS_URL=http://localhost:8000/?payment=success
STRIPE_CANCEL_URL=http://localhost:8000/?payment=cancelled
GOOGLE_PLAY_PACKAGE_NAME=
GOOGLE_PLAY_WEBHOOK_SECRET=
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
APPLE_BUNDLE_ID=
APPLE_SHARED_SECRET=
APPLE_IAP_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# Firebase Cloud Messaging (FCM HTTP v1)
# Provide either FCM_SERVICE_ACCOUNT_PATH (path to JSON) or FCM_SERVICE_ACCOUNT_JSON
# ------------------------------------------------------------------------------
FCM_PROJECT_ID=
FCM_SERVICE_ACCOUNT_PATH=
FCM_SERVICE_ACCOUNT_JSON=
FCM_HTTP_TIMEOUT_SECONDS=10.0

